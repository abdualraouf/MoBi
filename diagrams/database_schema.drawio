                <!-- TABLE: SHOP_SETTINGS -->
                <mxCell id="tbl_shop_settings" value="&lt;div style=&quot;background: #1e293b; color: #ffffff; padding: 8px 10px; font-weight: bold; font-size: 13px; text-align: center; border-radius: 6px 6px 0 0;&quot;&gt;shop_settings (إعدادات المحل والطباعة)&lt;/div&gt;&lt;div style=&quot;background: #ffffff; color: #000000; padding: 10px; font-size: 11px; line-height: 1.7; text-align: right;&quot;&gt;&lt;b style=&quot;color: #b45309;&quot;&gt;🔑 id&lt;/b&gt; : &lt;b style=&quot;color: #1d4ed8;&quot;&gt;Integer [PK]&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color: #000000;&quot;&gt;• shop_name&lt;/b&gt; : String(150)&lt;br&gt;&lt;b style=&quot;color: #000000;&quot;&gt;• phone / secondary_phone&lt;/b&gt; : String&lt;br&gt;&lt;b style=&quot;color: #000000;&quot;&gt;• address&lt;/b&gt; : String(200)&lt;br&gt;&lt;b style=&quot;color: #15803d;&quot;&gt;• currency&lt;/b&gt; : &lt;b style=&quot;color: #15803d;&quot;&gt;String(20) [ر.س/$/د.ك]&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color: #000000;&quot;&gt;• tax_number&lt;/b&gt; : String(50)&lt;br&gt;&lt;b style=&quot;color: #1d4ed8;&quot;&gt;• thermal_width&lt;/b&gt; : &lt;b style=&quot;color: #1d4ed8;&quot;&gt;String(10) [80mm/58mm]&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color: #000000;&quot;&gt;• invoice_footer&lt;/b&gt; : Text [شروط الفاتورة]&lt;br&gt;&lt;b style=&quot;color: #000000;&quot;&gt;• repair_terms&lt;/b&gt; : Text [شروط الصيانة]&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;shadow=1;strokeColor=#1e293b;strokeWidth=2.5;fillColor=#ffffff;align=right;verticalAlign=top;overflow=hidden;" parent="1" vertex="1">
                    <mxGeometry x="50" y="420" width="260" height="265" as="geometry"/>
                </mxCell>

                <!-- RELATIONSHIPS / CONNECTORS WITH HIGH CONTRAST SOLID BADGES -->

                <!-- Categories -> Products (1 to Many) -->
                <mxCell id="rel_cat_prod" value="&lt;b style=&quot;background: #0284c7; color: #ffffff; padding: 3px 6px; border-radius: 4px; font-size: 11px;&quot;&gt;1 : N (تصنيف)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;fontSize=11;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="tbl_categories" target="tbl_products">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Products -> ProductItems (1 to Many) -->
